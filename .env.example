# Copier ce fichier en .env et remplir toutes les valeurs marquées CHANGE_ME
# Le fichier .env ne doit JAMAIS être commité (il est dans .gitignore)
#
# Génération d'un JWT_SECRET fort :
#   openssl rand -hex 32

# ─── Base de données ────────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_strong_password

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_min_32_random_chars
# Durée de vie du token en minutes (1440 = 24h, 43200 = 30j)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Clé secrète : https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
# Webhook secret : https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ─── SendGrid (optionnel — laisser vide pour désactiver l'envoi réel) ───────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@saas-platform.com

# ─── Twilio (optionnel — laisser vide pour désactiver l'envoi réel) ─────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+33600000000

# ─── Multi-tenant ────────────────────────────────────────────────────────────
# Tenant par défaut pour les requêtes non authentifiées (login, register)
# Correspond au tenant "Default" seedé en base (ne pas modifier sauf changement de seed)
DEFAULT_TENANT_ID=1574b85d-a3df-400f-9e82-98831aa32934
