apiVersion: v1
kind: Secret
metadata:
  name: payment-secret
  namespace: microservices
type: Opaque
data:
  # IMPORTANT: Ne jamais commiter ce fichier avec des vraies valeurs
  # Les valeurs doivent être encodées en base64
  # Exemple: echo -n "sk_test_xxxxx" | base64
  
  # Stripe Secret Key (à remplacer par votre vraie clé)
  STRIPE_SECRET_KEY: c2tfdGVzdF95b3VyX3NlY3JldF9rZXlfaGVyZQ==
  
  # Stripe Webhook Secret (à remplacer par votre vrai secret)
  STRIPE_WEBHOOK_SECRET: d2hzZWNfeW91cl93ZWJob29rX3NlY3JldF9oZXJl
  
  # Database Password
  DB_PASSWORD: ZGV2X3Bhc3N3b3JkX2NoYW5nZV9pbl9wcm9k
  
  # JWT Secret
  JWT_SECRET: eW91ci1zdXBlci1zZWNyZXQta2V5LWNoYW5nZS1pbi1wcm9kdWN0aW9u




