#!/bin/bash

# Script d'exécution des migrations SQL pour la transformation Multi-Tenant SaaS
# Usage: ./run-migrations.sh [options]

set -e  # Exit on error

# Configuration
DB_HOST="${DB_HOST:-localhost}"
DB_PORT="${DB_PORT:-5432}"
DB_USER="${DB_USER:-saas_admin}"
DB_NAME="${DB_NAME:-saas_platform}"
MIGRATIONS_DIR="$(dirname "$0")"

# Couleurs pour output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Fonction d'aide
show_help() {
    cat << EOF
Usage: ./run-migrations.sh [options]

Options:
    -h, --help          Afficher cette aide
    -d, --dry-run       Afficher les migrations sans les exécuter
    -r, --rollback      Rollback (attention : perte de données)
    -f, --file FILE     Exécuter une migration spécifique

Exemples:
    ./run-migrations.sh                    # Exécuter toutes les migrations
    ./run-migrations.sh -f 001_*.sql       # Exécuter la migration 001
    ./run-migrations.sh --dry-run          # Tester sans exécuter

Configuration via variables d'environnement:
    DB_HOST, DB_PORT, DB_USER, DB_NAME, PGPASSWORD

EOF
}

# Fonction de log
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Vérifier la connexion PostgreSQL
check_connection() {
    log_info "Vérification de la connexion à PostgreSQL..."
    
    if ! pg_isready -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" > /dev/null 2>&1; then
        log_error "Impossible de se connecter à PostgreSQL"
        log_error "Host: $DB_HOST:$DB_PORT, User: $DB_USER, Database: $DB_NAME"
        exit 1
    fi
    
    log_info "✓ Connexion PostgreSQL OK"
}

# Créer l'extension uuid si nécessaire
create_extensions() {
    log_info "Vérification des extensions PostgreSQL..."
    
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -c \
        "CREATE EXTENSION IF NOT EXISTS \"uuid-ossp\";" > /dev/null 2>&1
    
    log_info "✓ Extensions OK"
}

# Lister les migrations
list_migrations() {
    log_info "Migrations disponibles:"
    for file in "$MIGRATIONS_DIR"/*.sql; do
        if [ -f "$file" ]; then
            echo "  - $(basename "$file")"
        fi
    done
}

# Exécuter une migration
run_migration() {
    local file=$1
    local filename=$(basename "$file")
    
    log_info "Exécution de $filename..."
    
    if [ "$DRY_RUN" = true ]; then
        log_warn "DRY-RUN: Migration non exécutée"
        return 0
    fi
    
    if psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -f "$file"; then
        log_info "✓ $filename exécutée avec succès"
        return 0
    else
        log_error "✗ Échec de $filename"
        return 1
    fi
}

# Exécuter toutes les migrations
run_all_migrations() {
    log_info "Exécution de toutes les migrations dans l'ordre..."
    
    local failed=0
    
    for file in "$MIGRATIONS_DIR"/0*.sql; do
        if [ -f "$file" ]; then
            if ! run_migration "$file"; then
                failed=1
                break
            fi
        fi
    done
    
    if [ $failed -eq 0 ]; then
        log_info "✓ Toutes les migrations ont été exécutées avec succès"
    else
        log_error "✗ Échec lors de l'exécution des migrations"
        exit 1
    fi
}

# Rollback (supprimer toutes les tables)
rollback() {
    log_warn "⚠️  ATTENTION: Le rollback va supprimer TOUTES les tables!"
    log_warn "⚠️  Cette action est IRREVERSIBLE!"
    
    if [ "$FORCE" != true ]; then
        read -p "Êtes-vous sûr de vouloir continuer? (tapez 'yes' pour confirmer): " confirmation
        if [ "$confirmation" != "yes" ]; then
            log_info "Rollback annulé"
            exit 0
        fi
    fi
    
    log_warn "Rollback en cours..."
    
    psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" << EOF
-- Désactiver RLS
ALTER TABLE IF EXISTS users DISABLE ROW LEVEL SECURITY;
ALTER TABLE IF EXISTS products DISABLE ROW LEVEL SECURITY;
ALTER TABLE IF EXISTS orders DISABLE ROW LEVEL SECURITY;
ALTER TABLE IF EXISTS payments DISABLE ROW LEVEL SECURITY;

-- Supprimer les tables (cascade)
DROP TABLE IF EXISTS refunds CASCADE;
DROP TABLE IF EXISTS subscriptions CASCADE;
DROP TABLE IF EXISTS payments CASCADE;
DROP TABLE IF EXISTS order_items CASCADE;
DROP TABLE IF EXISTS orders CASCADE;
DROP TABLE IF EXISTS reviews CASCADE;
DROP TABLE IF EXISTS favorites CASCADE;
DROP TABLE IF EXISTS products CASCADE;
DROP TABLE IF EXISTS users CASCADE;
DROP TABLE IF EXISTS tenants CASCADE;

-- Supprimer les vues
DROP VIEW IF EXISTS orders_with_stats CASCADE;
DROP VIEW IF EXISTS tenant_payment_stats CASCADE;

-- Supprimer les types ENUM
DROP TYPE IF EXISTS user_role CASCADE;
DROP TYPE IF EXISTS tenant_status CASCADE;
DROP TYPE IF EXISTS tenant_plan CASCADE;
DROP TYPE IF EXISTS order_status CASCADE;
DROP TYPE IF EXISTS payment_status CASCADE;
DROP TYPE IF EXISTS payment_status_enum CASCADE;
DROP TYPE IF EXISTS subscription_status_enum CASCADE;

-- Supprimer les sequences
DROP SEQUENCE IF EXISTS order_number_seq CASCADE;

-- Supprimer les fonctions
DROP FUNCTION IF EXISTS update_updated_at_column() CASCADE;
DROP FUNCTION IF EXISTS generate_order_number() CASCADE;
DROP FUNCTION IF EXISTS calculate_order_total(UUID) CASCADE;
DROP FUNCTION IF EXISTS update_product_rating() CASCADE;
DROP FUNCTION IF EXISTS check_expired_subscriptions() CASCADE;

EOF
    
    log_warn "✓ Rollback terminé"
}

# Afficher le statut des migrations
show_status() {
    log_info "Statut des migrations:"
    
    # Vérifier si les tables existent
    local tables=("tenants" "users" "products" "orders" "payments" "subscriptions")
    
    for table in "${tables[@]}"; do
        if psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME" -c "\dt $table" | grep -q "$table"; then
            echo -e "  ${GREEN}✓${NC} Table '$table' existe"
        else
            echo -e "  ${RED}✗${NC} Table '$table' n'existe pas"
        fi
    done
}

# Parse arguments
DRY_RUN=false
ROLLBACK=false
SPECIFIC_FILE=""
FORCE=false

while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;;
        -d|--dry-run)
            DRY_RUN=true
            shift
            ;;
        -r|--rollback)
            ROLLBACK=true
            shift
            ;;
        -f|--file)
            SPECIFIC_FILE="$2"
            shift 2
            ;;
        --force)
            FORCE=true
            shift
            ;;
        -s|--status)
            check_connection
            show_status
            exit 0
            ;;
        *)
            log_error "Option inconnue: $1"
            show_help
            exit 1
            ;;
    esac
done

# Main
echo "================================================"
echo "  Migrations PostgreSQL - Multi-Tenant SaaS"
echo "================================================"
echo ""

check_connection
create_extensions

if [ "$ROLLBACK" = true ]; then
    rollback
elif [ -n "$SPECIFIC_FILE" ]; then
    run_migration "$MIGRATIONS_DIR/$SPECIFIC_FILE"
else
    list_migrations
    echo ""
    run_all_migrations
fi

echo ""
show_status
echo ""
log_info "✓ Terminé!"




